<UserControl x:Class="RetailApp.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1100"
             Background="#F8FAFC">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Sales Transaction History" FontSize="22" FontWeight="Bold" Foreground="#0D2040"/>
                <TextBlock Text="Review past transactions, inspect line items, reprint customer receipts, and export audit sheets." FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="↻ Refresh" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" Margin="0,0,10,0"/>
                <Button Content="⬇ Export Transactions CSV" Style="{StaticResource SecondaryButton}" Command="{Binding ExportSalesCsvCommand}"/>
            </StackPanel>
        </Grid>

        <!-- Filter & KPI Metrics Toolbar -->
        <Border Grid.Row="1" Style="{StaticResource ModernCard}" Margin="0,0,0,16" Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" Height="36" Padding="8,4" FontSize="13" BorderBrush="#CBD5E1" Background="White"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Search by Invoice #, Cashier, or Payment"
                         Margin="0,0,12,0"/>

                <ComboBox Grid.Column="1" Height="36" FontSize="13" BorderBrush="#CBD5E1" Background="White"
                          SelectedValuePath="Content" SelectedValue="{Binding SelectedDateFilter}">
                    <ComboBoxItem Content="Today" IsSelected="True"/>
                    <ComboBoxItem Content="Last 7 Days"/>
                    <ComboBoxItem Content="This Month"/>
                    <ComboBoxItem Content="All Time"/>
                </ComboBox>

                <!-- Totals KPI pill on right -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#F1F5F9" CornerRadius="6" Padding="12,6" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Transactions: " FontWeight="SemiBold" Foreground="#64748B"/>
                            <TextBlock Text="{Binding TotalTransactionsCount}" FontWeight="Bold" Foreground="#0D2040"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="6" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Total Sales: " FontWeight="SemiBold" Foreground="#065F46"/>
                            <TextBlock Text="{Binding TotalSalesAmount, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" Foreground="#047857"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Master / Detail Grid -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Transactions DataGrid -->
            <Border Grid.Column="0" Style="{StaticResource ModernCard}" Padding="0">
                <DataGrid ItemsSource="{Binding SalesList}" SelectedItem="{Binding SelectedSale}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="INVOICE #" Binding="{Binding InvoiceNumber}" Width="150"/>
                        <DataGridTextColumn Header="DATE &amp; TIME" Binding="{Binding SaleDate, StringFormat='dd MMM yyyy, hh:mm tt'}" Width="160"/>
                        <DataGridTextColumn Header="CASHIER" Binding="{Binding CashierName}" Width="110"/>
                        <DataGridTextColumn Header="PAYMENT" Binding="{Binding PaymentMethod}" Width="90"/>
                        <DataGridTextColumn Header="ITEMS" Binding="{Binding TotalItemsCount}" Width="70"/>
                        <DataGridTextColumn Header="SUBTOTAL" Binding="{Binding Subtotal, Converter={StaticResource CurrencyConverter}}" Width="100"/>
                        <DataGridTextColumn Header="DISCOUNT" Binding="{Binding DiscountAmount, Converter={StaticResource CurrencyConverter}}" Width="95"/>
                        <DataGridTextColumn Header="GRAND TOTAL" Binding="{Binding GrandTotal, Converter={StaticResource CurrencyConverter}}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- RIGHT: Transaction Details Panel -->
            <Border Grid.Column="2" Style="{StaticResource ModernCard}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Details Header -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Transaction Details" FontSize="16" FontWeight="Bold" Foreground="#0D2040"/>
                        <TextBlock Text="{Binding SelectedSale.InvoiceNumber, FallbackValue='Select a transaction'}" FontSize="13" FontWeight="SemiBold" Foreground="#0066CC"/>
                    </StackPanel>

                    <!-- Meta Badges -->
                    <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid Margin="0,2">
                                <TextBlock Text="Date &amp; Time:" FontSize="11" Foreground="#64748B"/>
                                <TextBlock Text="{Binding SelectedSale.SaleDate, StringFormat='dd MMM yyyy hh:mm tt'}" FontSize="11" FontWeight="SemiBold" Foreground="#1E293B" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,2">
                                <TextBlock Text="Cashier:" FontSize="11" Foreground="#64748B"/>
                                <TextBlock Text="{Binding SelectedSale.CashierName}" FontSize="11" FontWeight="SemiBold" Foreground="#1E293B" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,2">
                                <TextBlock Text="Payment Mode:" FontSize="11" Foreground="#64748B"/>
                                <TextBlock Text="{Binding SelectedSale.PaymentMethod}" FontSize="11" FontWeight="SemiBold" Foreground="#1E293B" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Line Items List -->
                    <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Margin="0,0,0,10">
                        <DataGrid ItemsSource="{Binding SelectedSale.Items}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ITEM" Binding="{Binding ProductName}" Width="*"/>
                                <DataGridTextColumn Header="QTY" Binding="{Binding Quantity}" Width="45"/>
                                <DataGridTextColumn Header="PRICE" Binding="{Binding UnitPrice, Converter={StaticResource CurrencyConverter}}" Width="75"/>
                                <DataGridTextColumn Header="TOTAL" Binding="{Binding TotalPrice, Converter={StaticResource CurrencyConverter}}" Width="75"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Financial Breakdown -->
                    <StackPanel Grid.Row="3" Margin="0,0,0,12">
                        <Grid Margin="0,2">
                            <TextBlock Text="Subtotal" FontSize="12" Foreground="#64748B"/>
                            <TextBlock Text="{Binding SelectedSale.Subtotal, Converter={StaticResource CurrencyConverter}}" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <TextBlock Text="Discount" FontSize="12" Foreground="#10B981"/>
                            <TextBlock Text="{Binding SelectedSale.DiscountAmount, StringFormat='- Rs. {0:N2}'}" FontSize="12" FontWeight="SemiBold" Foreground="#10B981" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <TextBlock Text="Tax / VAT" FontSize="12" Foreground="#64748B"/>
                            <TextBlock Text="{Binding SelectedSale.TaxAmount, StringFormat='+ Rs. {0:N2}'}" FontSize="12" Foreground="#64748B" HorizontalAlignment="Right"/>
                        </Grid>

                        <Border BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Margin="0,4,0,4"/>

                        <Grid Margin="0,2">
                            <TextBlock Text="Grand Total" FontSize="14" FontWeight="Bold" Foreground="#0D2040"/>
                            <TextBlock Text="{Binding SelectedSale.GrandTotal, Converter={StaticResource CurrencyConverter}}" FontSize="16" FontWeight="ExtraBold" Foreground="#0D2040" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <TextBlock Text="Amount Tendered" FontSize="11" Foreground="#64748B"/>
                            <TextBlock Text="{Binding SelectedSale.AmountTendered, Converter={StaticResource CurrencyConverter}}" FontSize="11" Foreground="#64748B" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <TextBlock Text="Change Due" FontSize="11" FontWeight="Bold" Foreground="#10B981"/>
                            <TextBlock Text="{Binding SelectedSale.ChangeDue, Converter={StaticResource CurrencyConverter}}" FontSize="11" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>

                    <!-- Receipt Reprint Action Button -->
                    <Button Grid.Row="4" Content="🖨 Reprint / View Receipt" Style="{StaticResource PrimaryButton}"
                            Command="{Binding ViewReceiptCommand}" Height="40"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

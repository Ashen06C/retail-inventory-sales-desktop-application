<UserControl x:Class="RetailApp.Views.StockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1050"
             Background="#F8FAFC">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Stock &amp; Inventory Management" FontSize="22" FontWeight="Bold" Foreground="#0D2040"/>
                <TextBlock Text="Real-time stock balancing, purchase order restock, write-offs, and movement audit ledger." FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="↻ Refresh" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" Margin="0,0,10,0"/>
                <Button Content="⬇ Export Stock Sheet" Style="{StaticResource SecondaryButton}" Command="{Binding ExportStockCsvCommand}"/>
            </StackPanel>
        </Grid>

        <!-- Main Tab Control -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <!-- TAB 1: Live Inventory & Restock -->
            <TabItem Header="  📦 Inventory On-Hand &amp; Restock  " FontSize="14" FontWeight="SemiBold">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Stock KPI Pill Badges -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Total SKUs -->
                        <Border Grid.Column="0" Style="{StaticResource ModernCard}" Padding="14,10">
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#EFF6FF" CornerRadius="6" Width="36" Height="36" Margin="0,0,12,0">
                                    <TextBlock Text="🏷" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="TOTAL TRACKED SKUS" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding TotalItemsCount}" FontSize="18" FontWeight="Bold" Foreground="#0D2040"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Low Stock -->
                        <Border Grid.Column="2" Style="{StaticResource ModernCard}" Padding="14,10" Background="#FFFBEB" BorderBrush="#FDE68A">
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#FEF3C7" CornerRadius="6" Width="36" Height="36" Margin="0,0,12,0">
                                    <TextBlock Text="⚠️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="LOW STOCK WARNINGS" FontSize="10" FontWeight="Bold" Foreground="#B45309"/>
                                    <TextBlock Text="{Binding LowStockCount}" FontSize="18" FontWeight="Bold" Foreground="#D97706"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Out of Stock -->
                        <Border Grid.Column="4" Style="{StaticResource ModernCard}" Padding="14,10" Background="#FEF2F2" BorderBrush="#FECACA">
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#FEE2E2" CornerRadius="6" Width="36" Height="36" Margin="0,0,12,0">
                                    <TextBlock Text="🚫" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="OUT OF STOCK" FontSize="10" FontWeight="Bold" Foreground="#B91C1C"/>
                                    <TextBlock Text="{Binding OutOfStockCount}" FontSize="18" FontWeight="Bold" Foreground="#EF4444"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Filter & Operational Toolbar -->
                    <Border Grid.Row="1" Style="{StaticResource ModernCard}" Margin="0,0,0,14" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" Height="36" Padding="8,4" FontSize="13" BorderBrush="#CBD5E1" Background="White"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Search inventory by SKU or Name"
                                     Margin="0,0,10,0"/>

                            <ComboBox Grid.Column="1" Height="36" FontSize="13" BorderBrush="#CBD5E1" Background="White"
                                      ItemsSource="{Binding Categories}"
                                      SelectedItem="{Binding SelectedCategory}"
                                      Margin="0,0,10,0"/>

                            <ComboBox Grid.Column="2" Height="36" FontSize="13" BorderBrush="#CBD5E1" Background="White"
                                      SelectedValuePath="Content" SelectedValue="{Binding SelectedStockFilter}"
                                      Margin="0,0,10,0">
                                <ComboBoxItem Content="All Items" IsSelected="True"/>
                                <ComboBoxItem Content="Low Stock"/>
                                <ComboBoxItem Content="Out of Stock"/>
                            </ComboBox>

                            <!-- Restock and Adjust actions on selected row -->
                            <StackPanel Grid.Column="4" Orientation="Horizontal">
                                <Button Content="+ Receive Restock" Style="{StaticResource EmeraldButton}" Command="{Binding RestockCommand}" Height="36" Padding="14,0" Margin="0,0,10,0"/>
                                <Button Content="- Stock Adjustment" Style="{StaticResource SecondaryButton}" Command="{Binding AdjustStockCommand}" Height="36" Padding="14,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Inventory Table -->
                    <Border Grid.Row="2" Style="{StaticResource ModernCard}" Padding="0">
                        <DataGrid ItemsSource="{Binding InventoryProducts}" SelectedItem="{Binding SelectedProduct}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="90"/>
                                <DataGridTextColumn Header="PRODUCT NAME" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="CATEGORY" Binding="{Binding Category}" Width="120"/>
                                <DataGridTextColumn Header="COST PRICE" Binding="{Binding CostPrice, Converter={StaticResource CurrencyConverter}}" Width="110"/>
                                <DataGridTextColumn Header="SELLING PRICE" Binding="{Binding SellingPrice, Converter={StaticResource CurrencyConverter}}" Width="110"/>
                                <DataGridTextColumn Header="ON-HAND" Binding="{Binding CurrentStock}" Width="90"/>
                                <DataGridTextColumn Header="REORDER" Binding="{Binding ReorderLevel}" Width="80"/>
                                <DataGridTextColumn Header="UNIT" Binding="{Binding Unit}" Width="70"/>
                                <DataGridTemplateColumn Header="STATUS" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding StockStatus, Converter={StaticResource StockStatusBadgeBgConverter}}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding StockStatus}" Foreground="{Binding StockStatus, Converter={StaticResource StockStatusColorConverter}}" FontWeight="Bold" FontSize="11"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="TOTAL VAL (COST)" Binding="{Binding TotalStockValue, Converter={StaticResource CurrencyConverter}}" Width="130"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: Audit Trail Movement Ledger -->
            <TabItem Header="  📋 Stock Movement Audit Ledger  " FontSize="14" FontWeight="SemiBold">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#EEF2FF" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
                        <TextBlock Text="Every stock addition, sales deduction, manual restock, and write-off is logged below for complete regulatory and internal audit traceability." FontSize="12" Foreground="#3730A3"/>
                    </Border>

                    <!-- Ledger Table -->
                    <Border Grid.Row="1" Style="{StaticResource ModernCard}" Padding="0">
                        <DataGrid ItemsSource="{Binding StockMovements}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="DATE &amp; TIME" Binding="{Binding CreatedAt, StringFormat='dd MMM yyyy, hh:mm:ss tt'}" Width="180"/>
                                <DataGridTextColumn Header="SKU" Binding="{Binding ProductSku}" Width="90"/>
                                <DataGridTextColumn Header="PRODUCT NAME" Binding="{Binding ProductName}" Width="*"/>
                                <DataGridTemplateColumn Header="TYPE" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#F1F5F9" CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayBadgeType}" Foreground="{Binding MovementType, Converter={StaticResource MovementTypeColorConverter}}" FontWeight="Bold" FontSize="11"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="CHANGE" Binding="{Binding QuantityChange, StringFormat='{}{0:+0;-0;0}'}" Width="80"/>
                                <DataGridTextColumn Header="BEFORE" Binding="{Binding StockBefore}" Width="75"/>
                                <DataGridTextColumn Header="AFTER" Binding="{Binding StockAfter}" Width="75"/>
                                <DataGridTextColumn Header="REFERENCE" Binding="{Binding Reference}" Width="130"/>
                                <DataGridTextColumn Header="AUDIT REASON / NOTES" Binding="{Binding Notes}" Width="200"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>

<UserControl x:Class="RetailApp.Views.SalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1100"
             Background="#F8FAFC">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="460"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT PANE: Product Catalog & Fast Lookup -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Text="Point of Sale (POS) • Retail Checkout" FontSize="20" FontWeight="Bold" Foreground="#0D2040"/>
                <TextBlock Text="Search products, verify live stock availability, and build customer carts." FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Search & Filter Card -->
            <Border Grid.Row="1" Style="{StaticResource ModernCard}" Margin="0,0,0,14" Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Height="38" Padding="10,6" FontSize="13" BorderBrush="#CBD5E1" Background="White"
                             Text="{Binding ProductSearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Type SKU, Product Name, or scan Barcode to quickly find products"/>

                    <ComboBox Grid.Column="2" Height="38" FontSize="13" BorderBrush="#CBD5E1" Background="White"
                              ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding SelectedCategory}"/>

                    <Button Grid.Column="4" Content="↻ Reload" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCatalogCommand}" Height="38"/>
                </Grid>
            </Border>

            <!-- Product Catalog Grid -->
            <Border Grid.Row="2" Style="{StaticResource ModernCard}" Padding="0">
                <DataGrid ItemsSource="{Binding CatalogProducts}" SelectedItem="{Binding SelectedCatalogProduct}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="85"/>
                        <DataGridTextColumn Header="PRODUCT NAME" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="CATEGORY" Binding="{Binding Category}" Width="110"/>
                        <DataGridTextColumn Header="PRICE" Binding="{Binding SellingPrice, Converter={StaticResource CurrencyConverter}}" Width="95"/>
                        <DataGridTemplateColumn Header="STOCK" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CurrentStock}" FontWeight="Bold" HorizontalAlignment="Center"
                                               Foreground="{Binding StockStatus, Converter={StaticResource StockStatusColorConverter}}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="ACTION" Width="105">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="+ Add" Style="{StaticResource EmeraldButton}" Height="28" Padding="10,0" FontSize="12"
                                            Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- RIGHT PANE: Cart & Checkout Payment Calculation -->
        <Border Grid.Column="2" Style="{StaticResource ModernCard}" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Cart Header -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Current Transaction Cart" FontSize="16" FontWeight="Bold" Foreground="#0D2040"/>
                        <TextBlock Text="{Binding CartItems.Count, StringFormat='{}{0} unique item(s) in cart'}" FontSize="12" Foreground="#64748B"/>
                    </StackPanel>
                    <Button Content="Clear Cart" Style="{StaticResource SecondaryButton}" Command="{Binding ClearCartCommand}" HorizontalAlignment="Right" Height="30" Padding="10,0"/>
                </Grid>

                <!-- Cart Items List -->
                <Border Grid.Row="1" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Margin="0,0,0,12">
                    <DataGrid ItemsSource="{Binding CartItems}" SelectedItem="{Binding SelectedCartItem}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="ITEM" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ProductName}" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding UnitPrice, Converter={StaticResource CurrencyConverter}}" FontSize="10" Foreground="#64748B"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="QTY" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Button Content="-" Width="22" Height="22" Background="#E2E8F0" BorderThickness="0" FontWeight="Bold" Cursor="Hand"
                                                    Command="{Binding DataContext.DecrementQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <TextBlock Text="{Binding Quantity}" FontWeight="Bold" Width="28" TextAlignment="Center" VerticalAlignment="Center"/>
                                            <Button Content="+" Width="22" Height="22" Background="#E2E8F0" BorderThickness="0" FontWeight="Bold" Cursor="Hand"
                                                    Command="{Binding DataContext.IncrementQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="TOTAL" Binding="{Binding TotalPrice, Converter={StaticResource CurrencyConverter}}" Width="80"/>

                            <DataGridTemplateColumn Width="40">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="✕" Foreground="#EF4444" Background="Transparent" BorderThickness="0" FontWeight="Bold" FontSize="12" Cursor="Hand"
                                                Command="{Binding DataContext.RemoveFromCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Calculation & Discounts Breakdown -->
                <StackPanel Grid.Row="2" Margin="0,0,0,12">
                    <Grid Margin="0,2">
                        <TextBlock Text="Subtotal" FontSize="13" Foreground="#475569"/>
                        <TextBlock Text="{Binding Subtotal, Converter={StaticResource CurrencyConverter}}" FontSize="13" FontWeight="SemiBold" Foreground="#0D2040" HorizontalAlignment="Right"/>
                    </Grid>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="65"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Discount (%)" FontSize="12" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1" Height="28" Padding="4,2" FontSize="12" Text="{Binding DiscountPercentage, UpdateSourceTrigger=PropertyChanged}" Background="White" BorderBrush="#CBD5E1"/>
                        <TextBlock Grid.Column="2" Text="{Binding DiscountAmount, StringFormat='- Rs. {0:N2}'}" FontSize="12" Foreground="#10B981" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="65"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Tax / VAT (%)" FontSize="12" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1" Height="28" Padding="4,2" FontSize="12" Text="{Binding TaxPercentage, UpdateSourceTrigger=PropertyChanged}" Background="White" BorderBrush="#CBD5E1"/>
                        <TextBlock Grid.Column="2" Text="{Binding TaxAmount, StringFormat='+ Rs. {0:N2}'}" FontSize="12" Foreground="#64748B" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Grand Total Banner -->
                    <Border Background="#0D2040" CornerRadius="8" Padding="14,10" Margin="0,8,0,10">
                        <Grid>
                            <TextBlock Text="GRAND TOTAL" FontSize="13" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding GrandTotal, Converter={StaticResource CurrencyConverter}}" FontSize="22" FontWeight="ExtraBold" Foreground="White" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <!-- Payment Controls -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Payment Mode" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3"/>
                            <ComboBox Height="34" FontSize="12" SelectedValuePath="Content" SelectedValue="{Binding PaymentMethod}" Background="White">
                                <ComboBoxItem Content="Cash" IsSelected="True"/>
                                <ComboBoxItem Content="Card"/>
                                <ComboBoxItem Content="Transfer"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Amount Tendered (Rs)" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3"/>
                            <TextBox Height="34" Padding="6,4" FontSize="14" FontWeight="Bold" Text="{Binding AmountTendered, UpdateSourceTrigger=PropertyChanged}" Background="White" BorderBrush="#CBD5E1"/>
                        </StackPanel>
                    </Grid>

                    <!-- Quick Cash Tender Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                        <Button Content="Exact" Style="{StaticResource SecondaryButton}" Command="{Binding SetExactCashCommand}" Height="26" Padding="8,0" FontSize="11" Margin="0,0,6,0"/>
                        <Button Content="+500" Style="{StaticResource SecondaryButton}" Command="{Binding AddTenderedCashCommand}" CommandParameter="500" Height="26" Padding="8,0" FontSize="11" Margin="0,0,6,0"/>
                        <Button Content="+1000" Style="{StaticResource SecondaryButton}" Command="{Binding AddTenderedCashCommand}" CommandParameter="1000" Height="26" Padding="8,0" FontSize="11" Margin="0,0,6,0"/>
                        <Button Content="+5000" Style="{StaticResource SecondaryButton}" Command="{Binding AddTenderedCashCommand}" CommandParameter="5000" Height="26" Padding="8,0" FontSize="11"/>
                    </StackPanel>

                    <!-- Change Due -->
                    <Border Background="#F1F5F9" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                        <Grid>
                            <TextBlock Text="Change Due:" FontWeight="SemiBold" FontSize="13" Foreground="#334155" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ChangeDue, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" FontSize="16" Foreground="#10B981" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Final Action -->
                <Button Grid.Row="3" Content="✓ COMPLETE TRANSACTION &amp; PRINT" Style="{StaticResource EmeraldButton}"
                        Command="{Binding CompleteSaleCommand}" Height="46" FontSize="14" FontWeight="Bold"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>

<Window x:Class="RetailApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RetailApp.ViewModels"
        xmlns:views="clr-namespace:RetailApp.Views"
        Title="Retail Inventory &amp; Sales Management System"
        Height="800" Width="1280"
        MinHeight="680" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9"
        FontFamily="Segoe UI">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- DataTemplates for ViewModels -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SalesViewModel}">
            <views:SalesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProductViewModel}">
            <views:ProductView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StockViewModel}">
            <views:StockView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
            <views:HistoryView/>
        </DataTemplate>

        <!-- Sidebar Nav Button Style -->
        <Style x:Key="SidebarNavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="navBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="navBorder" Property="Background" Value="#1E3A66"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDEBAR: Deep Corporate Navy #0D2040 -->
        <Border Grid.Column="0" Background="#0D2040">
            <Grid Margin="16,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand Header -->
                <StackPanel Grid.Row="0" Margin="4,0,4,28">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#10B981" CornerRadius="6" Width="32" Height="32" Margin="0,0,10,0">
                            <TextBlock Text="RP" Foreground="White" FontWeight="Black" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="RETAIL" FontSize="17" FontWeight="Black" Foreground="White"/>
                            <TextBlock Text="POS" FontSize="12" FontWeight="Bold" Foreground="#10B981" Margin="0,-2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="Retail POS &amp; Inventory Suite" FontSize="11" Foreground="#94A3B8" Margin="0,8,0,0"/>
                </StackPanel>

                <!-- Navigation Links -->
                <StackPanel Grid.Row="1">
                    <TextBlock Text="MAIN MENU" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="12,0,0,8"/>

                    <!-- 1. Dashboard -->
                    <Button Style="{StaticResource SidebarNavButton}" Command="{Binding NavigateCommand}" CommandParameter="Dashboard"
                            Background="{Binding ActiveViewName, Converter={StaticResource ActiveNavBackgroundConverter}, ConverterParameter='Dashboard'}"
                            Foreground="{Binding ActiveViewName, Converter={StaticResource ActiveNavForegroundConverter}, ConverterParameter='Dashboard'}">
                        <Grid>
                            <Border Width="4" Height="22" Background="#10B981" CornerRadius="2" HorizontalAlignment="Left" Margin="-8,0,0,0"
                                    Visibility="{Binding ActiveViewName, Converter={StaticResource ActiveNavIndicatorVisibilityConverter}, ConverterParameter='Dashboard'}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="4,0,0,0">
                                <TextBlock Text="📊" Margin="0,0,12,0" FontSize="16"/>
                                <TextBlock Text="Dashboard" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- 2. Sales Screen -->
                    <Button Style="{StaticResource SidebarNavButton}" Command="{Binding NavigateCommand}" CommandParameter="Sales"
                            Background="{Binding ActiveViewName, Converter={StaticResource ActiveNavBackgroundConverter}, ConverterParameter='Sales'}"
                            Foreground="{Binding ActiveViewName, Converter={StaticResource ActiveNavForegroundConverter}, ConverterParameter='Sales'}">
                        <Grid>
                            <Border Width="4" Height="22" Background="#10B981" CornerRadius="2" HorizontalAlignment="Left" Margin="-8,0,0,0"
                                    Visibility="{Binding ActiveViewName, Converter={StaticResource ActiveNavIndicatorVisibilityConverter}, ConverterParameter='Sales'}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="4,0,0,0">
                                <TextBlock Text="🛒" Margin="0,0,12,0" FontSize="16"/>
                                <TextBlock Text="Sales Screen (POS)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- 3. Product Master -->
                    <Button Style="{StaticResource SidebarNavButton}" Command="{Binding NavigateCommand}" CommandParameter="Products"
                            Background="{Binding ActiveViewName, Converter={StaticResource ActiveNavBackgroundConverter}, ConverterParameter='Products'}"
                            Foreground="{Binding ActiveViewName, Converter={StaticResource ActiveNavForegroundConverter}, ConverterParameter='Products'}">
                        <Grid>
                            <Border Width="4" Height="22" Background="#10B981" CornerRadius="2" HorizontalAlignment="Left" Margin="-8,0,0,0"
                                    Visibility="{Binding ActiveViewName, Converter={StaticResource ActiveNavIndicatorVisibilityConverter}, ConverterParameter='Products'}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="4,0,0,0">
                                <TextBlock Text="🏷" Margin="0,0,12,0" FontSize="16"/>
                                <TextBlock Text="Products Master" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- 4. Stock Management -->
                    <Button Style="{StaticResource SidebarNavButton}" Command="{Binding NavigateCommand}" CommandParameter="Stock"
                            Background="{Binding ActiveViewName, Converter={StaticResource ActiveNavBackgroundConverter}, ConverterParameter='Stock'}"
                            Foreground="{Binding ActiveViewName, Converter={StaticResource ActiveNavForegroundConverter}, ConverterParameter='Stock'}">
                        <Grid>
                            <Border Width="4" Height="22" Background="#10B981" CornerRadius="2" HorizontalAlignment="Left" Margin="-8,0,0,0"
                                    Visibility="{Binding ActiveViewName, Converter={StaticResource ActiveNavIndicatorVisibilityConverter}, ConverterParameter='Stock'}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="4,0,0,0">
                                <TextBlock Text="📦" Margin="0,0,12,0" FontSize="16"/>
                                <TextBlock Text="Stock Management" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Low Stock Badge inside nav -->
                            <Border Background="#F59E0B" CornerRadius="10" MinWidth="22" Height="20" Padding="6,1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                                    Visibility="{Binding LowStockAlertCount, Converter={StaticResource NullToVisibilityConverter}}">
                                <TextBlock Text="{Binding LowStockAlertCount}" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Button>

                    <!-- 5. Transaction History -->
                    <Button Style="{StaticResource SidebarNavButton}" Command="{Binding NavigateCommand}" CommandParameter="History"
                            Background="{Binding ActiveViewName, Converter={StaticResource ActiveNavBackgroundConverter}, ConverterParameter='History'}"
                            Foreground="{Binding ActiveViewName, Converter={StaticResource ActiveNavForegroundConverter}, ConverterParameter='History'}">
                        <Grid>
                            <Border Width="4" Height="22" Background="#10B981" CornerRadius="2" HorizontalAlignment="Left" Margin="-8,0,0,0"
                                    Visibility="{Binding ActiveViewName, Converter={StaticResource ActiveNavIndicatorVisibilityConverter}, ConverterParameter='History'}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="4,0,0,0">
                                <TextBlock Text="🧾" Margin="0,0,12,0" FontSize="16"/>
                                <TextBlock Text="Transaction History" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- Cashier Profile Footer -->
                <Border Grid.Row="2" Background="#112A52" CornerRadius="8" Padding="12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#1E3A66" CornerRadius="18" Width="36" Height="36">
                            <TextBlock Text="👤" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Cashier 01" FontWeight="Bold" FontSize="13" Foreground="White"/>
                            <TextBlock Text="Colombo 10 Outlet" FontSize="11" Foreground="#94A3B8"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- RIGHT CONTENT AREA -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="32"/>
            </Grid.RowDefinitions>

            <!-- TOP HEADER BAR -->
            <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="24,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Active View & Status Indicator -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusMessage}" FontSize="15" FontWeight="SemiBold" Foreground="#0D2040" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Header Right: Alert Pill & Live Clock -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Clickable Low Stock Warning Pill -->
                        <Button Style="{StaticResource SecondaryButton}" Command="{Binding ViewAlertsCommand}" Height="34" Padding="10,0" Margin="0,0,14,0"
                                Background="#FFFBEB" BorderBrush="#FCD34D" Foreground="#B45309"
                                ToolTip="Click to view and replenish low stock items">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚠️ " FontWeight="Bold"/>
                                <TextBlock Text="{Binding LowStockAlertCount, StringFormat='{}{0} Low Stock Alert(s)'}" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>

                        <!-- Live Digital Clock -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12,6">
                            <TextBlock Text="{Binding CurrentTimeString}" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- MAIN DYNAMIC CONTENT HOST -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentView}"/>

            <!-- BOTTOM STATUS BAR -->
            <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,0">
                <Grid VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="System Online" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="Retail Inventory &amp; Sales Suite" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>

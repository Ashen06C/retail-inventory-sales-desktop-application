<Window x:Class="RetailApp.Dialogs.StockAdjustWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stock Adjustment" Height="540" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="TxtTitle" Text="Stock Adjustment / Restock" FontSize="20" FontWeight="Bold" Foreground="#0D2040"/>
            <TextBlock x:Name="TxtSubtitle" Text="Update inventory count with compulsory audit reference and notes." FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Error banner -->
        <Border Grid.Row="1" x:Name="BorderError" Background="#FEE2E2" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,12" Visibility="Collapsed">
            <TextBlock x:Name="TxtErrorMessage" Text="Validation Error" Foreground="#B91C1C" FontWeight="SemiBold" TextWrapping="Wrap"/>
        </Border>

        <!-- Main Form -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
            <StackPanel>

                <!-- Product Summary Card -->
                <Border Background="#F1F5F9" CornerRadius="8" Padding="14,12" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="TxtProdName" Text="Ceylon Premium Black Tea 100g" FontWeight="Bold" FontSize="15" Foreground="#0D2040"/>
                            <TextBlock x:Name="TxtProdSku" Text="SKU: BEV-101 • Category: Beverages" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Border Grid.Column="1" Background="White" CornerRadius="6" Padding="12,6" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="CURRENT STOCK" FontSize="10" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtCurrentStock" Text="45 Units" FontSize="16" FontWeight="Bold" Foreground="#0D2040" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Adjustment Type -->
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="Operation / Movement Type *" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbMovementType" Height="38" FontSize="13" SelectionChanged="CmbMovementType_SelectionChanged" Background="White"/>
                </StackPanel>

                <!-- Quantity & New Balance Preview -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="LblQuantity" Text="Quantity to Add *" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtQuantity" Height="38" Padding="8,6" FontSize="14" BorderBrush="#CBD5E1" Background="White" TextChanged="TxtQuantity_TextChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Resulting Stock Balance" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                        <Border Height="38" Background="#E2E8F0" CornerRadius="4" Padding="10,0">
                            <TextBlock x:Name="TxtResultingStock" Text="45 Units" VerticalAlignment="Center" FontWeight="Bold" FontSize="15" Foreground="#0D2040"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Reference / Doc Number -->
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="Reference / Document # (e.g. PO-0042, GRN-109, ADJ-01)" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtReference" Height="38" Padding="8,6" FontSize="13" BorderBrush="#CBD5E1" Background="White"/>
                </StackPanel>

                <!-- Compulsory Reason Notes -->
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="Reason / Audit Note *" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtNotes" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Padding="8,6" FontSize="13" BorderBrush="#CBD5E1" Background="White"/>
                    <TextBlock Text="Required for inventory audit and management accountability." FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Actions -->
        <Border Grid.Row="3" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Width="100" Height="40" Background="#F1F5F9" Foreground="#475569" BorderThickness="0" FontWeight="SemiBold" Click="BtnCancel_Click" Cursor="Hand" Margin="0,0,12,0"/>
                <Button x:Name="BtnSubmit" Content="Apply Adjustment" Width="150" Height="40" Background="#0D2040" Foreground="White" BorderThickness="0" FontWeight="Bold" Click="BtnSubmit_Click" Cursor="Hand"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

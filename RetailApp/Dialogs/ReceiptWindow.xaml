<Window x:Class="RetailApp.Dialogs.ReceiptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sales Receipt" Height="680" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#E2E8F0"
        FontFamily="Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Printable Receipt Sheet Container -->
        <Border Grid.Row="0" x:Name="ReceiptBorder" Background="White" CornerRadius="8" Padding="24" Margin="0,0,0,16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.1" Color="#000000"/>
            </Border.Effect>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Store Brand Header -->
                    <TextBlock Text="RETAIL STORE POS" FontSize="18" FontWeight="ExtraBold" Foreground="#0D2040" HorizontalAlignment="Center"/>
                    <TextBlock Text="Retail Operations &amp; Distribution" FontSize="12" FontWeight="SemiBold" Foreground="#475569" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    <TextBlock Text="No. 400, Deans Road, Colombo 10, Sri Lanka" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    <TextBlock Text="Tel: +94 11 200 0000  •  support@retailpos.com" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,1,0,8"/>

                    <!-- Dashed line -->
                    <Border BorderBrush="#CBD5E1" BorderThickness="0,1,0,0" Margin="0,4,0,10"/>

                    <!-- Invoice metadata -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="RECEIPT / INVOICE" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                            <TextBlock x:Name="TxtInvoiceNum" Text="INV-20260908-0001" FontSize="13" FontWeight="Bold" Foreground="#0D2040"/>
                            <TextBlock x:Name="TxtCashier" Text="Cashier: Cashier 01" FontSize="11" Foreground="#475569" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock Text="DATE &amp; TIME" FontSize="10" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Right"/>
                            <TextBlock x:Name="TxtDateTime" Text="08 Sep 2026 07:15 PM" FontSize="11" FontWeight="SemiBold" Foreground="#0D2040" HorizontalAlignment="Right"/>
                            <TextBlock x:Name="TxtPayMethod" Text="Payment: Cash" FontSize="11" Foreground="#475569" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Border BorderBrush="#CBD5E1" BorderThickness="0,1,0,0" Margin="0,0,0,10"/>

                    <!-- Items Header -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="ITEM DESCRIPTION" FontSize="11" FontWeight="Bold" Foreground="#475569"/>
                        <TextBlock Grid.Column="1" Text="QTY" FontSize="11" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="TOTAL (RS)" FontSize="11" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- Items List -->
                    <ItemsControl x:Name="ListReceiptItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding ProductName}" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding UnitPrice, StringFormat='@ Rs. {0:N2}'}" FontSize="10" Foreground="#64748B"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" Text="{Binding Quantity}" FontSize="12" Foreground="#334155" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding TotalPrice, StringFormat='{}{0:N2}'}" FontSize="12" FontWeight="SemiBold" Foreground="#0D2040" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border BorderBrush="#CBD5E1" BorderThickness="0,1,0,0" Margin="0,10,0,10"/>

                    <!-- Summary calculation -->
                    <Grid Margin="0,2">
                        <TextBlock Text="Subtotal" FontSize="12" Foreground="#475569"/>
                        <TextBlock x:Name="TxtSubtotal" Text="Rs. 0.00" FontSize="12" Foreground="#475569" HorizontalAlignment="Right"/>
                    </Grid>

                    <Grid x:Name="GridDiscount" Margin="0,2">
                        <TextBlock x:Name="LblDiscount" Text="Discount" FontSize="12" Foreground="#10B981"/>
                        <TextBlock x:Name="TxtDiscount" Text="- Rs. 0.00" FontSize="12" Foreground="#10B981" HorizontalAlignment="Right"/>
                    </Grid>

                    <Grid x:Name="GridTax" Margin="0,2">
                        <TextBlock x:Name="LblTax" Text="Tax" FontSize="12" Foreground="#64748B"/>
                        <TextBlock x:Name="TxtTax" Text="+ Rs. 0.00" FontSize="12" Foreground="#64748B" HorizontalAlignment="Right"/>
                    </Grid>

                    <Border BorderBrush="#0D2040" BorderThickness="0,1.5,0,1.5" Margin="0,8,0,8" Padding="0,6">
                        <Grid>
                            <TextBlock Text="TOTAL PAYABLE" FontSize="14" FontWeight="ExtraBold" Foreground="#0D2040"/>
                            <TextBlock x:Name="TxtGrandTotal" Text="Rs. 0.00" FontSize="16" FontWeight="ExtraBold" Foreground="#0D2040" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <Grid Margin="0,2">
                        <TextBlock Text="Amount Tendered" FontSize="12" Foreground="#475569"/>
                        <TextBlock x:Name="TxtTendered" Text="Rs. 0.00" FontSize="12" Foreground="#475569" HorizontalAlignment="Right"/>
                    </Grid>

                    <Grid Margin="0,2">
                        <TextBlock Text="Change Due" FontSize="12" FontWeight="Bold" Foreground="#0D2040"/>
                        <TextBlock x:Name="TxtChange" Text="Rs. 0.00" FontSize="12" FontWeight="Bold" Foreground="#0D2040" HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- Footer -->
                    <Border BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Margin="0,16,0,8"/>
                    <TextBlock Text="*** THANK YOU FOR YOUR BUSINESS! ***" FontSize="11" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                    <TextBlock Text="Goods sold in good order are subject to store policy." FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,2,0,0"/>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Dialog Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Close" Width="100" Height="40" Background="#CBD5E1" Foreground="#334155" BorderThickness="0" FontWeight="SemiBold" Click="BtnClose_Click" Cursor="Hand" Margin="0,0,12,0"/>
            <Button Content="Print / Save Receipt" Width="160" Height="40" Background="#0D2040" Foreground="White" BorderThickness="0" FontWeight="Bold" Click="BtnPrint_Click" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
